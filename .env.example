# Set only after confirming ownership and the final canonical host.
# Complete HTTPS origin, no path/query/port. No default production domain.
SITE_URL=
# false on previews; true (or unset) on production with a confirmed SITE_URL.
SEO_INDEXABLE=false
# Set true in the production build job to fail if SITE_URL is missing.
SEO_REQUIRE_SITE_URL=false
